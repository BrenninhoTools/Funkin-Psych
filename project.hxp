package;

import hxp.*;
import lime.tools.*;
import sys.FileSystem;
import sys.io.File;
import sys.io.Process;

using StringTools;

class Project extends HXProject
{
	static inline final TITLE:String = "Friday Night Funkin': Psych Engine";
	static inline final MOBILE_TITLE:String = "FNF: Psych Engine";
	static inline final FILE:String = "PsychEngine";
	static inline final PACKAGE:String = "me.funkin.psychengine";
	static inline final VERSION:String = "0.2.8";
	static inline final COMPANY:String = "ShadowMario";

	var excludedAssets:Map<String, Bool>;
	var features:Array<Feature> = [];
	var gitHash:String = "";
	var gitBranch:String = "";
	var gitDirty:Bool = false;

	static final SKIPPED_ASSET_FOLDERS:Array<String> = ["exclude", "tutorial"];
	static final SKIPPED_ASSET_PATHS:Array<String> = ["assets/preload/data", "assets/preload/scripts"];
	static final SKIPPED_ASSET_FILES:Array<String> = ["*.hxc", "*.md", "*.yml"];
	static final DEFAULT_EXCLUDE:Array<String> = [".*", "cvs", "thumbs.db", "desktop.ini", "*.fla", "*.hash"];

	public function new()
	{
		super();

		setupApplication();
		setupBuildInfo();
		setupFeatures();
		setupWindow();
		setupPlatforms();
		setupAssets();
		setupLibraries();
		setupHaxedefs();
		setupIcons();
		printSummary();
	}

	function setupApplication()
	{
		meta.title = isMobile() ? MOBILE_TITLE : TITLE;
		meta.packageName = PACKAGE;
		meta.version = VERSION;
		meta.company = COMPANY;

		app.file = FILE;
		app.main = "Main";
		app.preloader = "flixel.system.FlxPreloader";
		setDefine("SWF_VERSION", "11.8");
		app.path = hasDefine("32bits") ? "export/32bit" : (debug ? "export/debug" : "export/release");

		setDefine("APP_ID", "0x0100f6c013bbc000");
		setHaxedef("LINC_LUA_RELATIVE_DYNAMIC_LIB");

		sources.push("source");
	}

	function setupBuildInfo()
	{
		gitHash = git(["rev-parse", "--short=10", "HEAD"]);
		gitBranch = Sys.getEnv("GITHUB_REF_NAME");
		if (gitBranch == null || gitBranch.length == 0) gitBranch = git(["rev-parse", "--abbrev-ref", "HEAD"]);
		gitDirty = git(["status", "--porcelain", "--untracked-files=no"]).length > 0;

		if (gitHash.length > 0) setHaxedef("GIT_HASH", gitHash);
		if (gitBranch.length > 0) setHaxedef("GIT_BRANCH", gitBranch);
		if (gitDirty) setHaxedef("GIT_MODIFIED");
		setHaxedef("BUILD_DATE", DateTools.format(Date.now(), "%Y-%m-%d"));

		var runNumber:String = Sys.getEnv("GITHUB_RUN_NUMBER");
		if (Sys.getEnv("GITHUB_ACTIONS") == "true")
		{
			enable("CI_BUILD");
			if (runNumber != null && ~/^[0-9]+$/.match(runNumber))
			{
				setHaxedef("BUILD_NUMBER", runNumber);
				meta.buildNumber = runNumber;
			}
		}
	}

	function setupFeatures()
	{
		var native:Bool = isDesktop() || isMobile();
		var officialVideo:Bool = hasDefine("officialBuild") && !hasDefine("32bits") && isTarget([Platform.WINDOWS, Platform.LINUX, Platform.MAC, Platform.ANDROID, Platform.IOS]);

		features = [
			new Feature("MODS_ALLOWED", native),
			new Feature("HSCRIPT_ALLOWED", native, ["hscript"]),
			new Feature("LUA_ALLOWED", native, ["linc_luajit"]),
			new Feature("POLYMOD_ALLOWED", native, ["polymod", "thx.core", "thx.semver", "jsonpath", "jsonpatch"]),
			new Feature("CPPIA_ALLOWED", native, [], ["NO_CPPIA"]),
			new Feature("FOXLITE_ALLOWED", native, ["foxlite"], ["NO_FOXLITE"]),
			new Feature("ACHIEVEMENTS_ALLOWED", true),
			new Feature("DISCORD_ALLOWED", native, ["hxdiscord_rpc"], ["NO_DISCORD"]),
			new Feature("TRANSLATIONS_ALLOWED", true),
			new Feature("IRIS_DEBUG", true),
			new Feature("MULTITHREADED_LOADING", true),
			new Feature("SHOW_LOADING_SCREEN", true),
			new Feature("PSYCH_WATERMARKS", true),
			new Feature("TITLE_SCREEN_EASTER_EGG", hasDefine("officialBuild")),
			new Feature("BASE_GAME_FILES", hasDefine("officialBuild"), ["grig.audio", "funkin.vis"]),
			new Feature("VIDEOS_ALLOWED", officialVideo, ["hxvlc"], ["NO_VIDEOS"]),
			new Feature("CRASH_HANDLER", native && !debug),
			new Feature("CHECK_FOR_UPDATES", isDesktop() && hasDefine("officialBuild")),
			new Feature("x86_BUILD", hasDefine("32bits"))
		];

		for (feature in features)
		{
			feature.resolve(this);
			if (feature.enabled) enable(feature.name);
			else if (feature.forced) Log.warn('Feature ${feature.name} was requested but is disabled');
		}
	}

	function setupWindow()
	{
		window.width = 1280;
		window.height = 720;
		window.fps = 60;
		window.background = 0x000000;
		window.hardware = true;
		window.vsync = false;
		window.allowHighDPI = true;

		if (isWeb()) window.resizable = true;

		if (isDesktop())
		{
			window.orientation = Orientation.LANDSCAPE;
			window.fullscreen = false;
			window.resizable = true;
			window.vsync = false;
		}

		if (isMobile())
		{
			window.orientation = Orientation.LANDSCAPE;
			window.fullscreen = true;
			window.width = 0;
			window.height = 0;
			window.resizable = false;
		}
	}

	function setupPlatforms()
	{
		if (target == Platform.ANDROID)
		{
			architectures = [Architecture.ARM64];
			excludeArchitectures = [Architecture.ARMV7, Architecture.X86];

			if (hasDefine("ANDROID_SIGNING"))
				keystore = new Keystore("release.keystore", Sys.getEnv("ANDROID_KEYSTORE_PASSWORD"), Sys.getEnv("ANDROID_KEY_ALIAS"), Sys.getEnv("ANDROID_KEY_PASSWORD"));

			dependencies.push(new Dependency("psychmobile", "project/android/psychmobile"));
			config.push("android.extension", "org.psychengine.mobile.FileDialogs");
			config.push("android.extension", "org.psychengine.mobile.ScreenExtension");
			setupPlayGames();
		}

		if (target == Platform.IOS)
		{
			for (framework in ["PhotosUI", "AudioToolbox", "AVFoundation", "CoreAudio", "CoreFoundation", "UIKit"])
				dependencies.push(new Dependency('$framework.framework', ""));
			templatePaths.push("templates");
		}
	}

	function setupAssets()
	{
		var web:Bool = isWeb();
		var skipAudio:String = web ? "*.ogg" : "*.mp3";

		excludedAssets = new Map();
		for (skipped in SKIPPED_ASSET_PATHS) excludedAssets.set(skipped, true);
		if (!hasDefine("BASE_GAME_FILES")) excludeAssetList("project/assets/base_game.txt");
		if (!hasDefine("TITLE_SCREEN_EASTER_EGG")) excludeAssetList("project/assets/secrets.txt");
		if (!hasDefine("TRANSLATIONS_ALLOWED")) excludeAssetList("project/assets/translations.txt");

		var folders:Array<String> = FileSystem.readDirectory("assets");
		folders.sort(Reflect.compare);
		for (folder in folders)
		{
			var path:String = "assets/" + folder;
			if (!FileSystem.isDirectory(path) || SKIPPED_ASSET_FOLDERS.indexOf(folder) > -1) continue;
			switch (folder)
			{
				case "fonts":
					addAssetPath(path);
				case "embed":
					addAssetPath(path, null, [skipAudio], true);
				case "videos":
					if (hasDefine("VIDEOS_ALLOWED")) addAssetPath(path);
				default:
					addAssetPath(path, null, [skipAudio]);
			}
		}

		if (hasDefine("MODS_ALLOWED"))
		{
			if (target == Platform.MAC || isMobile()) addAssetPath("example_mods", "mods", null, false);
			else addAssetPath("example_mods", "mods", null, false, AssetType.TEMPLATE);
			assets.push(new Asset("list.txt", "modsList.txt"));
		}
		assets.push(new Asset("art/readme.txt", "do NOT readme.txt"));

		if (isDesktop() && FileSystem.exists("alsoft.txt"))
			assets.push(new Asset("alsoft.txt", target == Platform.WINDOWS ? "plugins/alsoft.ini" : "plugins/alsoft.conf", AssetType.TEXT));

		if (target == Platform.LINUX || target == Platform.MAC)
			assets.push(new Asset("art/icons/iconOG.png", "icon.png"));
	}

	function setupLibraries()
	{
		for (lib in ["flixel", "flixel-addons", "tjson", "haxeui-core", "haxeui-flixel", "flxanimate"])
			addHaxelib(lib);

		for (feature in features)
			if (feature.enabled)
				for (lib in feature.haxelibs)
					addHaxelib(lib);

		if (target == Platform.ANDROID) addHaxelib("android-manager");
		if (target == Platform.IOS) addHaxelib("extension-iostools");
		if (isMobile()) addHaxelib("extension-haptics");
		if (debug) addHaxelib("hxcpp-debug-server");
	}

	function setupHaxedefs()
	{
		if (target == Platform.LINUX) setHaxedef("NO_PRECOMPILED_HEADERS");

		if (hasDefine("VIDEOS_ALLOWED"))
		{
			setHaxedef("HXVLC_NO_SHARE_DIRECTORY");
			if (debug) setHaxedef("HXC_LIBVLC_LOGGING");
		}

		setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");
		if (debug) setHaxedef("HXC_DEBUG_TRACE");
		else
		{
			setHaxedef("FLX_NO_DEBUG");
			setHaxedef("NAPE_RELEASE_BUILD");
		}

		if (hasDefine("CRASH_HANDLER"))
		{
			setHaxedef("HXCPP_CHECK_POINTER");
			setHaxedef("HXCPP_STACK_LINE");
			setHaxedef("HXCPP_STACK_TRACE");
		}

		setHaxedef("no-deprecation-warnings");
		setHaxedef("message.reporting", "pretty");
		if (hasDefine("HSCRIPT_ALLOWED"))
		{
			setHaxedef("hscriptPos");
			for (keep in ["StringTools", "Lambda", "Std", "Math", "Reflect", "Type", "DateTools", "haxe.io.Path", "haxe.Json"])
				haxeflags.push("--macro keep('" + keep + "')");
		}

		if (hasDefine("POLYMOD_ALLOWED"))
		{
			setHaxedef("POLYMOD_SCRIPT_EXT", ".hxc");
			setHaxedef("POLYMOD_SCRIPT_CLASS_EXT", ".hxc");
			setHaxedef("POLYMOD_SCRIPT_LIBRARY", "default");
			setHaxedef("POLYMOD_ROOT_PATH", "scripts/");
			setHaxedef("POLYMOD_APPEND_FOLDER", "_append");
			setHaxedef("POLYMOD_MERGE_FOLDER", "_merge");
			setHaxedef("POLYMOD_MOD_METADATA_FILE", "_polymod_meta.json");
			setHaxedef("POLYMOD_MOD_ICON_FILE", "_polymod_icon.png");
			if (debug) setHaxedef("POLYMOD_DEBUG");
			haxeflags.push("--macro include('funkin.modding.base')");
		}

		if (hasDefine("CPPIA_ALLOWED"))
		{
			setHaxedef("scriptable");
			setHaxedef("dll_export", "export_classes.info");
			haxeflags.push("--macro include('funkin.scripting.cppia')");
		}

		haxeflags.push("--macro allowPackage('flash')");
		haxeflags.push("--macro include('my.pack')");
	}

	function setupIcons()
	{
		icons.push(new Icon("art/icons/icon16.png", 16));
		icons.push(new Icon("art/icons/icon32.png", 32));
		icons.push(new Icon("art/icons/icon64.png", 64));
		icons.push(new Icon("art/icons/iconOG.png"));
	}

	function setupPlayGames()
	{
		if (hasDefine("NO_PLAY_GAMES")) return;

		var appId:String = setting("PLAY_GAMES_APP_ID", "project/android/play_games_app_id.txt");
		if (appId == null) return;
		if (!~/^[0-9]+$/.match(appId))
		{
			Log.warn('Ignoring PLAY_GAMES_APP_ID "$appId", it must be the numeric project id');
			return;
		}

		setDefine("PLAY_GAMES_APP_ID", appId);
		setHaxedef("PLAY_GAMES_APP_ID", appId);
		if (!hasDefine("PLAY_GAMES_SIGN_IN")) setDefine("PLAY_GAMES_SIGN_IN", "silent");
		if (config.getInt("android.minimum-sdk-version", 21) < 23) config.set("android.minimum-sdk-version", 23);
	}

	function printSummary()
	{
		if (!Log.verbose && !hasDefine("BUILD_SUMMARY")) return;

		var enabled:Array<String> = [for (feature in features) if (feature.enabled) feature.name];
		var disabled:Array<String> = [for (feature in features) if (!feature.enabled) feature.name];
		Log.info("");
		Log.info('$TITLE $VERSION (${gitHash.length > 0 ? gitHash : "no git"}${gitDirty ? ", modified" : ""}) for ${Std.string(target).toLowerCase()}${debug ? " debug" : ""}');
		Log.info("Enabled: " + enabled.join(", "));
		if (disabled.length > 0) Log.info("Disabled: " + disabled.join(", "));
		Log.info("Haxelibs: " + [for (lib in haxelibs) lib.name].join(", "));
		Log.info("");
	}

	function setting(name:String, ?file:String):Null<String>
	{
		var value:String = hasDefine(name) ? defines.get(name) : Sys.getEnv(name);
		if ((value == null || value.trim().length == 0) && file != null && FileSystem.exists(file)) value = File.getContent(file);
		if (value == null) return null;
		value = value.trim();
		return value.length > 0 ? value : null;
	}

	function git(args:Array<String>):String
	{
		try
		{
			var process:Process = new Process("git", args);
			var output:String = process.stdout.readAll().toString().trim();
			var code:Int = process.exitCode();
			process.close();
			return code == 0 ? output : "";
		}
		catch (e:Dynamic)
		{
			return "";
		}
	}

	function isTarget(platforms:Array<Platform>):Bool
	{
		return platforms.indexOf(target) > -1;
	}

	public function isDefined(name:String):Bool
	{
		return defines.exists(name);
	}

	function enable(name:String)
	{
		setDefine(name);
		setHaxedef(name);
	}

	function setDefine(name:String, value:String = "")
	{
		defines.set(name, value);
	}

	function setHaxedef(name:String, value:String = "")
	{
		haxedefs.set(name, value);
	}

	function hasDefine(name:String):Bool
	{
		return defines.exists(name);
	}

	function addHaxelib(name:String, ?version:String)
	{
		for (lib in haxelibs)
			if (lib.name == name) return;
		haxelibs.push(new Haxelib(name, version != null ? version : ""));
	}

	function isMobile():Bool
	{
		return platformType == PlatformType.MOBILE;
	}

	function isDesktop():Bool
	{
		return platformType == PlatformType.DESKTOP;
	}

	function isWeb():Bool
	{
		return platformType == PlatformType.WEB;
	}

	function excludeAssetList(listPath:String)
	{
		if (!FileSystem.exists(listPath)) return;
		for (line in sys.io.File.getContent(listPath).split("\n"))
		{
			var entry:String = line.trim();
			if (entry.length > 0) excludedAssets.set("assets/" + entry, true);
		}
	}

	function addAssetPath(path:String, ?rename:String, ?exclude:Array<String>, ?embed:Bool, ?type:AssetType)
	{
		if (!FileSystem.exists(path) || !FileSystem.isDirectory(path)) return;
		var excludes:Array<String> = DEFAULT_EXCLUDE.concat(SKIPPED_ASSET_FILES).concat(exclude != null ? exclude : []);
		addAssetFolder(path, rename != null ? rename : path, excludes, embed, type);
	}

	function addAssetFolder(path:String, targetPath:String, exclude:Array<String>, embed:Null<Bool>, type:AssetType)
	{
		for (file in FileSystem.readDirectory(path))
		{
			var full:String = path + "/" + file;
			var renamed:String = targetPath + "/" + file;
			if (excludedAssets.exists(full)) continue;
			if (FileSystem.isDirectory(full))
			{
				if (filter(file, ["*"], exclude)) addAssetFolder(full, renamed, exclude, embed, type);
			}
			else if (filter(file, ["*"], exclude))
			{
				assets.push(new Asset(full, renamed, type, embed));
			}
		}
	}
}

class Feature
{
	public var name(default, null):String;
	public var haxelibs(default, null):Array<String>;
	public var enabled(default, null):Bool = false;
	public var forced(default, null):Bool = false;

	var byDefault:Bool;
	var disableFlags:Array<String>;

	public function new(name:String, byDefault:Bool, ?haxelibs:Array<String>, ?disableFlags:Array<String>)
	{
		this.name = name;
		this.byDefault = byDefault;
		this.haxelibs = haxelibs != null ? haxelibs : [];
		this.disableFlags = ["NO_" + name].concat(disableFlags != null ? disableFlags : []);
	}

	public function resolve(project:Project):Void
	{
		forced = project.isDefined(name) || project.isDefined("FORCE_" + name);
		var disabled:Bool = false;
		for (flag in disableFlags)
			if (project.isDefined(flag)) disabled = true;
		enabled = !disabled && (byDefault || forced);
	}
}
