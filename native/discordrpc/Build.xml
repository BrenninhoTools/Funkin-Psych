<xml>
	<files id="funkin_discord" dir="${this_dir}">
		<compilerflag value="-I${this_dir}/include"/>
		<compilerflag value="-I${this_dir}/src"/>
		<depend name="${this_dir}/include/funkin_discord.h"/>
		<depend name="${this_dir}/src/platform/platform.h"/>
		<file name="src/discord_rpc.cpp"/>
		<file name="src/platform/platform_windows.cpp"/>
		<file name="src/platform/platform_posix.cpp"/>
		<file name="src/platform/platform_mobile.cpp"/>
	</files>

	<files id="haxe">
		<compilerflag value="-I${this_dir}/include"/>
	</files>

	<target id="haxe">
		<files id="funkin_discord"/>
		<lib name="-lpthread" if="linux"/>
	</target>
</xml>
