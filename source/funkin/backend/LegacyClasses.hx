	static var proxiesRegistered:Bool = false;

	public static function resolveClass(name:String):Class<Dynamic>
	{
		if (name == null) return null;
		var cls:Class<Dynamic> = Type.resolveClass(name);
		if (cls == null && PATHS.contains(name)) cls = Type.resolveClass('funkin.' + name);
		return cls;
	}

	public static function resolveEnum(name:String):Enum<Dynamic>
	{
		if (name == null) return null;
		var en:Enum<Dynamic> = Type.resolveEnum(name);
		if (en == null && PATHS.contains(name)) en = Type.resolveEnum('funkin.' + name);
		return en;
	}

	#if HSCRIPT_ALLOWED
	public static function registerProxies()
	{
		if (proxiesRegistered) return;
		proxiesRegistered = true;
		for (path in PATHS)
		{
			if (crowplexus.iris.Iris.proxyImports.exists(path)) continue;
			var value:Dynamic = Type.resolveClass('funkin.' + path);
			if (value == null) value = Type.resolveEnum('funkin.' + path);
			if (value != null) crowplexus.iris.Iris.addProxyImport(path, value);
		}
	}
	#end
